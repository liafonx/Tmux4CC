# Bark push server — reuses the *.liafonx.net wildcard cert that
# acme.sh installs to /etc/caddy/certs/wildcard.liafonx.net and reloads on renew.
# Install: sudo cp ~/bark-server/bark.liafonx.net.caddy /etc/caddy/sites-available/ && sudo systemctl reload caddy
bark.liafonx.net {
    tls /etc/caddy/certs/wildcard.liafonx.net/fullchain.pem /etc/caddy/certs/wildcard.liafonx.net/privkey.pem

    reverse_proxy 127.0.0.1:8087

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /var/log/caddy/bark_access.log
        format json
    }
}
