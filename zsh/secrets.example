# ~/.zsh_secrets — machine-local credentials, NOT in git.
# Copy this file to ~/.zsh_secrets on each machine, then fill in values.
# Permissions: chmod 600 ~/.zsh_secrets
# Sourced by: ~/.config/tmux4cc/zsh/shared/zshenv.zsh

# ── Bark push notifications for Claude Code hooks (all machines) ─────────────
# Read by hooks/notify.sh (it greps only BARK_* lines, so Desktop-app sessions work too).
# Hub URL and BARK_HUB_TOKEN_<SOURCE>: one token per source and machine, minted in bark-hub.
export BARK_HUB_URL=""
export BARK_HUB_TOKEN_CLAUDE=""
# export BARK_HUB_TOKEN_ROUTINE=""
# export BARK_HUB_TOKEN_SUBSIDECAR=""
# export BARK_HUB_TOKEN_DOWNLOAD=""

# bark-hub is the only push path.
# export BARK_HOST_LABEL="MacBook"   # name shown in pushes (default: hostname -s)

# ── Cloudflare DNS API (Mac Mini + Linux VPS only) ───────────────────────────
# export CF_Token=""

# ── NordVPN credentials (Linux VPS only) ─────────────────────────────────────
# export NORD_USERNAME=""
# export NORD_PASSWORD=""
